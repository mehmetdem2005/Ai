# ── Metin üretimi (LLM) ─────────────────────────────
# Sağlayıcı: deepseek | gemini
LLM_PROVIDER=deepseek
# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...
# deepseek-v4-pro (frontier) | deepseek-reasoner (R1/düşünme) | deepseek-chat
DEEPSEEK_MODEL=deepseek-reasoner
# Gemini (BEDAVA): https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.5-flash

# ── Embedding (anlamsal dedup) ──────────────────────
# Sağlayıcı: gemini (ücretsiz) | openai
EMBEDDING_PROVIDER=gemini
# Boş = sağlayıcı varsayılanı (gemini-embedding-001 / text-embedding-3-small)
EMBEDDING_MODEL=
# OpenAI SADECE embedding için (metin üretiminde kullanılmaz)
OPENAI_API_KEY=
DEDUP_THRESHOLD=0.86

# ── Supabase (opsiyonel kalıcılık) ──────────────────
# Project Settings → API → Project URL ve bir API key (service_role veya anon)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=

# ── Genel ───────────────────────────────────────────
MAX_ENTRIES_PER_FEED=10
# NEWSLETTER_TITLE=🧬 MedTech & AI Signal
# SYSTEM_PROMPT=

# ── V2/V3 — Filtreleme ve Skorlama (hardcode prangası yok: 0 = sınırsız) ─
# Kaynak başına taze haber kotası — 0=sınırsız (LLM skoru filtreler)
MAX_NEW_PER_SOURCE=0
# Bültene girmek için minimum etki puanı (1-10)
MIN_IMPACT_SCORE=7
# Bültene giren maksimum haber — 0=sınırsız (eşiği geçen herkes)
MAX_PUBLISHED=0
# Kümeleme/growth için Gemini modeli (yoksa GEMINI_MODEL fallback)
# CLUSTER_MODEL=gemini-2.5-flash
# GROWTH_MODEL=gemini-2.5-flash

# ── V3 — HITL Kokpit + Otomatik yayın emniyet sübabı ─────
# Streamlit panel şifresi (zorunlu — yoksa panel kilitli)
ADMIN_PASSWORD=DEĞİŞTİR_BUNU_GÜÇLÜ_BIR_ŞİFRE
# En eski pending bu kadar saat beklerse worker otomatik yayınlar (0=tamamen kapalı, katı HITL)
AUTO_PUBLISH_AFTER_HOURS=24

# ── V3 — Beehiiv dağıtımı (anahtar yoksa Beehiiv adımı atlanır, site çalışır) ─
# Beehiiv → Settings → Integrations → API Keys
BEEHIIV_API_KEY=
BEEHIIV_PUB_ID=pub_...

# ── V3 — Uptime/healthcheck (opsiyonel) ─────────
# UptimeRobot / healthchecks.io heartbeat URL'i; worker başarıyla bittikten sonra GET atar.
HEALTHCHECK_URL=
