logs/*.log
outputs/*.md

# Yerel sırlar (compose env_file ile dışarıdan verilir)
.env
.env.local

# Editor/OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Dokümanlar (image içine gerek yok)
docs/
README*.md
*.md.bak
hermes/
infra/
