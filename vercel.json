{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 web/build.py",
  "outputDirectory": "web/dist",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/landing", "destination": "/", "permanent": true },
    { "source": "/landing.html", "destination": "/", "permanent": true },
    { "source": "/yonetim", "destination": "/admin", "permanent": true },
    { "source": "/yonetim.html", "destination": "/admin", "permanent": true },
    { "source": "/admin.html", "destination": "/legacy-admin", "permanent": false }
  ],
  "rewrites": [
    { "source": "/b/:id", "destination": "/reader.html?bulten=:id" },
    { "source": "/bulten/:id", "destination": "/reader.html?bulten=:id" },
    { "source": "/admin", "destination": "/admin/index.html" }
  ]
}
