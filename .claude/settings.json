{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // \"\"' | grep -q '/web/' && python3 scripts/web_consistency_check.py 2>&1 || true",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/web_consistency_check.py 2>&1 || true",
            "timeout": 30,
            "statusMessage": "Tutarlılık denetimi…"
          }
        ]
      }
    ]
  }
}
