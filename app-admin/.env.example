# Sovereign Admin (Next.js) — env örneği
# Bu değerleri Vercel project settings → Environment Variables'a gir.

# Panel şifresi (zorunlu)
ADMIN_PASSWORD=guclu-bir-sifre

# Cookie imzası için rastgele uzun string (zorunlu, gizli tut)
SESSION_SECRET=32-karakterden-uzun-rastgele-string

# Supabase (service_role anahtarı önerilir — RLS bypass için)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=

# Beehiiv (opsiyonel — yoksa atlanır)
BEEHIIV_API_KEY=
BEEHIIV_PUB_ID=

# Sosyal post üretimi (Gemini, OpenAI uyumlu endpoint)
GEMINI_API_KEY=
GROWTH_MODEL=gemini-2.5-flash

# Yayın sonrası halka açık siteyi tazele
VERCEL_DEPLOY_HOOK_URL=

# Yan paneldeki "otomatik yayına kalan" geri sayımı için
AUTO_PUBLISH_AFTER_HOURS=24
NEWSLETTER_TITLE=MedTech Sinyali
